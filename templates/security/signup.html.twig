{% extends 'base.html.twig' %}

{% block title %}
    Inscription | Rapide & Gourmand
{% endblock %}

{% block body %}

    <section class="signin">

        <div class="container">

            <div class="signin__card">

                <h1>Inscription</h1>

                <p>
                    Créez votre compte pour profiter de nos services.
                </p>

                <form id="signup-form" data-turbo="false">

                    <div class="mb-3">

                        <label for="firstName" class="form-label">
                            Prénom
                        </label>

                        <input id="firstName" name="firstName"
                               type="text" class="form-control" required>

                    </div>

                    <div class="mb-3">

                        <label for="lastName" class="form-label">
                            Nom
                        </label>

                        <input id="lastName" name="lastName"
                               type="text" class="form-control" required>

                    </div>

                    <div class="mb-3">

                        <label for="email" class="form-label">
                            Adresse e-mail
                        </label>

                        <input id="email" name="email"
                               type="email" class="form-control" required>

                        <div id="email-feedback"
                             class="form-text"
                             aria-live="polite">
                        </div>

                    </div>

                    <div class="mb-3">

                        <label for="password" class="form-label">
                            Mot de passe
                        </label>

                        <input id="password" name="password"
                               type="password" class="form-control" required>

                        <div id="password-feedback"
                             class="mt-2"
                             aria-live="polite">

                            <small class="text-muted">
                                Votre mot de passe doit contenir :
                            </small>

                            <ul class="list-unstyled small mb-0">

                                <li data-rule="length" class="text-muted">
                                    ○ 8 caractères minimum
                                </li>

                                <li data-rule="lowercase" class="text-muted">
                                    ○ Une lettre minuscule
                                </li>

                                <li data-rule="uppercase" class="text-muted">
                                    ○ Une lettre majuscule
                                </li>

                                <li data-rule="number" class="text-muted">
                                    ○ Un chiffre
                                </li>

                                <li data-rule="special" class="text-muted">
                                    ○ Un caractère spécial
                                </li>

                            </ul>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label for="confirmPassword" class="form-label">
                            Confirmer le mot de passe
                        </label>

                        <input id="confirmPassword"
                               type="password"
                               class="form-control"
                               required>

                        <div id="confirm-password-feedback"
                             class="form-text"
                             aria-live="polite">
                        </div>

                    </div>

                    <div class="mb-3">

                        <label for="phone" class="form-label">
                            Téléphone
                        </label>

                        <input id="phone" name="phone"
                               type="text" class="form-control" required>

                    </div>

                    <div class="mb-3">

                        <label for="street" class="form-label">
                            Adresse
                        </label>

                        <input id="street" name="street"
                               type="text" class="form-control" required>

                    </div>

                    <div class="mb-3">

                        <label for="postalCode" class="form-label">
                            Code postal
                        </label>

                        <input id="postalCode" name="postalCode"
                               type="text" class="form-control" required>

                    </div>

                    <div class="mb-4">

                        <label for="city" class="form-label">
                            Ville
                        </label>

                        <input id="city" name="city"
                               type="text" class="form-control" required>

                    </div>

                    <div id="signup-error"
                         class="alert alert-danger d-none"
                         role="alert">
                    </div>

                    <button type="submit" class="btn-hero">
                        Créer mon compte
                    </button>

                    <p class="mt-3 text-center">
                        Déjà un compte ?
                        <a href="{{ path('app_signin') }}">
                            Se connecter
                        </a>
                    </p>

                </form>

            </div>

        </div>

    </section>

{% endblock %}